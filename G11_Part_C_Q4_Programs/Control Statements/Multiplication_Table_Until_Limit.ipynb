          "text": [
            "Enter number: 10\n",
            "Enter limit: 4\n",
            "10 x 1 = 10\n",
            "10 x 2 = 20\n",
            "10 x 3 = 30\n",
            "10 x 4 = 40\n"
          ]
        }
      ],
      "source": [
        "#Accept a number and a limit, then generate its multiplication table using a while loop.\n",
        "\n",
        "number = int(input(\"Enter number: \"))\n",
        "limit = int(input(\"Enter limit: \"))\n",
        "\n",
        "i = 1\n",
        "\n",
        "while i <= limit:\n",
        "\n",
        "    print(number, \"x\", i, \"=\", number * i)\n",
        "\n",
        "    i += 1"
      ]
    }
  ]
