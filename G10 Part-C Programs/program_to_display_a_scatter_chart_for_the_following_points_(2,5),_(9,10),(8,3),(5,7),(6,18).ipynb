      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Coordinates\n",
        "x = [2, 9, 8, 5, 6]\n",
        "y = [5, 10, 3, 7, 18]\n",
        "\n",
        "# Create scatter chart\n",
        "plt.scatter(x, y)\n",
        "\n",
        "# Title and labels\n",
        "plt.title(\"Scatter Chart\")\n",
        "plt.xlabel(\"X-axis\")\n",
        "plt.ylabel(\"Y-axis\")\n",
        "\n",
        "# Display the chart\n",
        "plt.show()"
      ]
    }
  ]
