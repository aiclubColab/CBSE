      "source": [
        "# Define two lists\n",
        "list1 = [10, 20, 30, 40]\n",
        "list2 = [1, 2, 3, 4]\n",
        "\n",
        "\n",
        "# Add corresponding elements\n",
        "result = []\n",
        "\n",
        "\n",
        "for i in range(len(list1)):\n",
        "    result.append(list1[i] + list2[i])\n",
        "\n",
        "\n",
        "# Display the result\n",
        "print(\"Sum of the two lists:\", result)"
      ]
    }
  ]
