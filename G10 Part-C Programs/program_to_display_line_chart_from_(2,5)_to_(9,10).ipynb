      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Coordinates\n",
        "x = [2, 9]\n",
        "y = [5, 10]\n",
        "\n",
        "# Plot line chart\n",
        "plt.plot(x, y, marker='o')\n",
        "\n",
        "# Title and labels\n",
        "plt.title(\"Line Chart\")\n",
        "plt.xlabel(\"X-axis\")\n",
        "plt.ylabel(\"Y-axis\")\n",
        "\n",
        "# Display the chart\n",
        "plt.show()"
      ]
    }
  ]
